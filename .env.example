# ─────────────────────────────────────────────────────────────────────────────
# Grtlabs — environment configuration
#
# Copy this file to `.env.local` (which is gitignored and never shipped) and fill
# in real values. Every variable here is read ONLY on the server (API routes /
# server components); nothing in this file is exposed to the browser unless it is
# explicitly prefixed with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth / session ───────────────────────────────────────────────────────────
# Secret used to sign the session cookie that guards the dashboard routes.
# MUST be long and random (32+ bytes) — the whole session model rests on it.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=
# The single dashboard password (simple single-user gate). Make it long; it is
# one of only two factors. Swap for a real provider if more people need access.
DASHBOARD_PASSWORD=
# TOTP second factor (optional but recommended). A standard Base32 secret — add
# the same secret to your authenticator app (Aegis/Google Authenticator/1Password
# etc., SHA-1, 6 digits, 30s period). When set, sign-in requires the code; codes
# are single-use and failed attempts are rate-limited. Leave blank to disable.
TWO_FACTOR_SECRET=

# ── Proxmox VE ───────────────────────────────────────────────────────────────
# Used server-side via the `proxmox-api` package for node CPU/RAM, VM/CT status,
# and uptime. Create an API token in Proxmox (Datacenter → Permissions → API
# Tokens) and prefer a read-only role.
PROXMOX_HOST=https://proxmox.lan:8006
PROXMOX_TOKEN_ID=root@pam!grtlabs
PROXMOX_TOKEN_SECRET=
# Set to "false" only if you are NOT using a valid TLS cert (self-signed labs).
PROXMOX_VERIFY_TLS=true

# ── TrueNAS SCALE ────────────────────────────────────────────────────────────
# JSON-RPC 2.0 over WebSocket (wss://<host>/api/current) — SCALE 25.04 deprecated
# the REST API. Pool health/capacity and uptime. Create an API key under
# Credentials → Users; a least-privilege "Readonly Admin" role is enough.
TRUENAS_HOST=https://truenas.lan
TRUENAS_API_KEY=
TRUENAS_VERIFY_TLS=true

# ── Home Assistant ───────────────────────────────────────────────────────────
# Long-lived access token (Profile → Security → Long-Lived Access Tokens).
# Used for a curated set of entity states.
HOMEASSISTANT_HOST=https://homeassistant.lan:8123
HOMEASSISTANT_TOKEN=
# Optional: comma-separated entity ids to pin on the console's Automation panel
# (e.g. "climate.living_room,light.office,sensor.power"). Leave blank and the
# panel auto-picks a sensible handful; the assistant can always list everything.
HOMEASSISTANT_ENTITIES=

# ── Jellyfin ─────────────────────────────────────────────────────────────────
# Used via @jellyfin/sdk for now-playing, recent media, and active sessions.
# Create an API key under Dashboard → API Keys.
JELLYFIN_HOST=https://jellyfin.lan:8096
JELLYFIN_API_KEY=

# ── Cloudflare live traffic (optional) ───────────────────────────────────────
# Powers the ambient "terrain" behind the landing's telemetry waves with REAL
# per-minute request counts for your zone (counts only — no IPs, paths, or user
# data ever leave the server). Leave both blank to disable; the canvas then falls
# back to its synthetic traces and the "live via Cloudflare" caption is hidden.
#
# Requires your site to be proxied through Cloudflare (orange cloud). Create a
# scoped API token at dash.cloudflare.com → My Profile → API Tokens with the
# permission  Zone → Analytics → Read  (restricted to this one zone). The Zone ID
# is on the zone's Overview page, lower-right. The three busiest hostnames in the
# last 5 min become the three labeled "wires"; their request rate sets how many
# live packets flow along each. All calls are server-side and cached, so the
# Cloudflare API is queried at most once per ~50s regardless of visitor count.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Development preview only: with no real credentials above, set this to 1 to feed
# the visualization a local SAMPLE series (clearly labeled "sample data" in the
# UI). Real credentials always take precedence. Leave unset in production.
CLOUDFLARE_MOCK=

# ── Assistant SSH (run_shell) ───────────────────────────────────────────────
# Gives the operator assistant shell access for what the REST APIs can't do
# (exec inside a container, read logs). Point it at the ENTRY Proxmox node;
# `pct exec` only reaches guests on that node, so on a multi-node cluster the
# assistant targets the owning node per call (it resolves a node name to its IP).
# Can also be set from the dashboard Settings panel. Use a key OR a password.
# Shell access is ALWAYS a confirm-gated action.
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
# PEM private key (overrides password). One line with \n, or set via Settings.
SSH_PRIVATE_KEY=

# ── Operator assistant (console sidebar) ────────────────────────────────────
# The console's chat assistant. Keys are read ONLY server-side and never reach
# the browser. ANTHROPIC_API_KEY is preferred (Claude); GEMINI_API_KEY works as
# a fallback provider. Keys can ALSO be added from the console's model menu —
# those are stored write-only in data/assistant-keys.json (gitignored); env
# values here always win over stored ones. Leave both blank and the sidebar
# offers the in-UI key form instead.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional default-model overrides (the sidebar's model menu can pick any model
# from the provider's live list). Defaults: claude-opus-4-8 / gemini-2.5-flash.
ASSISTANT_MODEL=
GEMINI_MODEL=

# ── Public landing ───────────────────────────────────────────────────────────
# How often the public status pulse re-checks aggregate health, in seconds.
# Read on the client, so it must be NEXT_PUBLIC_. Safe to expose.
NEXT_PUBLIC_STATUS_POLL_SECONDS=20
